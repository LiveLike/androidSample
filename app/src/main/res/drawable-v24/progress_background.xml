<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="2dp" />

        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="2dp" />
                <gradient
                    android:angle="0"
                    android:centerY="1.0"
                    android:endColor="@color/livelike_poll_bar_gradient_right"
                    android:startColor="@color/livelike_poll_bar_gradient_left" />
            </shape>
        </clip>
    </item>
</layer-list>