<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_reaction_count"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="2dp"
        >

        <ImageView
            android:id="@+id/img_reaction"
            android:layout_width="@dimen/img_reaction_width"
            android:layout_height="@dimen/img_reaction_height"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="0dp"
            android:layout_marginBottom="0dp"
            android:contentDescription="image_reaction"
            android:paddingStart="@dimen/img_reaction_padding_start"
            android:paddingTop="@dimen/img_reaction_padding_top"
            android:paddingEnd="@dimen/img_reaction_padding_end"
            android:paddingBottom="@dimen/img_reaction_padding_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/txt_reaction_count"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/txt_reaction_count"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/txt_reaction_count_height"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:textColor="#14232D"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_reaction"
            app:layout_constraintTop_toTopOf="parent"
            android:fontFamily="@font/tnt_digital_medium"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>