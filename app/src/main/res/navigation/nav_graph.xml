<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.android.tf1samples.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.android.tf1samples.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />
    </fragment>

    <fragment
        android:id="@+id/ThirdFragment"
        android:name="com.android.tf1samples.ThirdFragment"
        android:label="Third Fragment"
        tools:layout="@layout/fragment_third">

        <action
            android:id="@+id/action_ThirdFragment_to_ForthFragment"
            app:destination="@id/forthFragment" />
    </fragment>
    <fragment
        android:id="@+id/forthFragment"
        android:name="com.android.tf1samples.ForthFragment"
        android:label="ForthFragment"
        tools:layout="@layout/fragment_forth">
        <action
            android:id="@+id/action_forthFragment_to_ReactionFragment"
            app:destination="@id/ReactionFragment" />
    </fragment>
    <fragment
        android:id="@+id/ReactionFragment"
        android:name="com.android.tf1samples.ReactionFragment"
        android:label="ReactionFragment"
        tools:layout="@layout/fragment_reaction">
        <action
            android:id="@+id/action_ReactionFragment_to_FifthFragment"
            app:destination="@id/FifthFragment" />
    </fragment>
    <fragment
        android:id="@+id/FifthFragment"
        android:name="com.android.tf1samples.FifthFragment"
        android:label="FifthFragment"
        tools:layout="@layout/fragment_reaction">
        <action
            android:id="@+id/action_FifthFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />

    </fragment>

</navigation>